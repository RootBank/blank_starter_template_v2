{
  "include": [
    "./code/**/*",
    "./__tests__/**/*"
  ],
  "compilerOptions": {
    "lib": [
      "es2023"
    ],
    "module": "es2022",
    "target": "es2023",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "downlevelIteration": true,
    "noEmit": true,
    "types": [
      "jest"
    ]
  }
}
